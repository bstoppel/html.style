{
  "name": "html.style",
  "version": "2026.1.0",
  "description": "Modern web standards CSS framework with OKLCH colors, container queries, and semantic HTML",
  "main": "dist/css/html.style.css",
  "style": "dist/css/html.style.css",
  "exports": {
    ".": "./dist/css/html.style.css",
    "./css": "./dist/css/html.style.css",
    "./components": "./dist/components/index.js",
    "./components/*": "./dist/components/*",
    "./bundle": "./dist/js/html.style.components.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "customElements": "dist/custom-elements.json",
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:visual": "playwright test tests/visual",
    "test:a11y": "playwright test tests/a11y",
    "test:atoms": "playwright test tests/atoms",
    "test:performance": "playwright test tests/performance",
    "test:components": "playwright test tests/components",
    "test:update-snapshots": "playwright test --update-snapshots=all",
    "test:debug": "playwright test --debug",
    "build": "node build.js",
    "build:check": "node build.js --check",
    "docs:check": "node check-docs.js",
    "serve": "http-server dist -p 8080",
    "start": "npm run serve"
  },
  "keywords": [
    "css",
    "framework",
    "html",
    "oklch",
    "container-queries",
    "cascade-layers",
    "design-system",
    "web-standards",
    "boilerplate",
    "starter-template",
    "semantic-html",
    "dark-mode",
    "atomic-design",
    "progressive-enhancement"
  ],
  "author": "html.style contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bstoppel/html.style.git"
  },
  "bugs": {
    "url": "https://github.com/bstoppel/html.style/issues"
  },
  "homepage": "https://github.com/bstoppel/html.style#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "chrome >= 131",
    "edge >= 131",
    "firefox >= 133",
    "safari >= 18",
    "ios_saf >= 18",
    "and_chr >= 131"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@playwright/test": "^1.58.0",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
