    {
      "kind": "javascript-module",
      "path": "dist/components/hs-card.js",
      "declarations": [
        {
          "kind": "class",
          "description": "<hs-card> — CSS-only element.\n\nThere is no behaviour here and no shadow root. The global stylesheet styles\n`hs-card` directly, so the element renders correctly with JavaScript disabled,\nbefore any script loads, and if this module is never imported at all.\n\nThe class below exists ONLY so the element appears in custom-elements.json and\neditors offer completion for it. Nothing about rendering depends on it being\nregistered — delete the import and the card still looks exactly the same.\n\nWhy an element rather than `class=\"card\"`: the tag name carries the meaning,\nwhich is what a machine reads first, and it keeps one authoring vocabulary —\neverything is `<hs-*>` whether or not it has behaviour. The `.card` class\nstays supported.",
          "name": "HsCard",
          "cssProperties": [
            {
              "description": "Card background.",
              "name": "--color-surface-elevated"
            },
            {
              "description": "Card border.",
              "name": "--color-border-default"
            },
            {
              "description": "Internal padding and gap.",
              "name": "--space-component"
            }
          ],
          "slots": [
            {
              "description": "The card's content.",
              "name": ""
            }
          ],
          "superclass": {
            "name": "HTMLElement"
          },
          "tagName": "hs-card",
          "customElement": true
        }
      ],
      "exports": [
        {
          "kind": "js",
          "name": "HsCard",
          "declaration": {
            "name": "HsCard",
            "module": "dist/components/hs-card.js"
          }
        },
        {
          "kind": "custom-element-definition",
          "name": "hs-card",
          "declaration": {
            "name": "HsCard",
            "module": "dist/components/hs-card.js"
          }
        }
      ]
    },
