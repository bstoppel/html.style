# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.css text
*.html text
*.js text
*.json text
*.md text
*.txt text
*.svg text
*.webmanifest text

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
